# GEMINI_API_KEY: Required for Gemini AI API calls (viral analysis, scoring, caption translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model ID used for structured viral moment detection, scoring, and translation.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PYTHON_BACKEND_URL: URL of the single Python FastAPI video processing backend.
# Default is port 8001 so it does not collide with host port 8000 services.
PYTHON_BACKEND_URL="http://127.0.0.1:8001"

# VITE_PYTHON_BACKEND_URL: Optional public browser-accessible URL for direct client calls.
# Leave empty to route safely through the same-origin /api/* proxy to PYTHON_BACKEND_URL.
VITE_PYTHON_BACKEND_URL=""

# Transcription (faster-whisper)
WHISPER_MODEL_SIZE="large-v3-turbo"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Worker pools & persistence
MAX_CONCURRENT_JOBS="2"
MAX_RENDER_WORKERS="2"
SQLITE_DB_PATH="backend/data/scalereach.db"

# Media ingest limits & optional cookies for yt-dlp
MAX_VIDEO_SIZE_MB="2048"
MAX_VIDEO_DURATION_SEC="14400"
YOUTUBE_COOKIES_FILE=""
YOUTUBE_COOKIES=""
